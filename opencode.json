{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "model": "openai/FAIT-gpt-5.6-opencode",
  "small_model": "openai/fait-gpt-5.4-Custom",
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "instructions": [
    ".opencode/standards/project-globals.md"
  ],
  "permission": {
    "bash": "ask",
    "edit": "ask",
    "write": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "skill": "allow"
  },
  "agent": {
    "orchestrator": { "model": "openai/FAIT-gpt-5.6-opencode" },
    "technical-functional-analyst": { "model": "openai/FAIT-gpt-5.6-opencode" },
    "sad-architect-reviewer": { "model": "openai/FAIT-gpt-5.6-opencode" },
    "planner": { "model": "openai/FAIT-gpt-5.6-opencode" },
    "domain-engineer": { "model": "openai/FAIT-gpt-5.6-opencode" },
    "persistence-engineer": { "model": "openai/fait-gpt-5.4-Custom" },
    "web-engineer": { "model": "openai/fait-gpt-5.4-Custom" },
    "frontend-engineer": { "model": "openai/fait-gpt-5.4-Custom" },
    "test-engineer": { "model": "openai/fait-gpt-5.4-Custom" },
    "spec-reviewer": { "model": "openai/fait-gpt-5.4-Custom" },
    "code-reviewer": { "model": "openai/fait-gpt-5.4-Custom" },
    "documentation-engineer": { "model": "openai/FAIT-gpt-5.6-opencode" }
  }
}